# =============================================================================
# Plantilla de variables de entorno de Ambienta
# =============================================================================
#
# Este archivo se versiona; el .env real NO (está en .gitignore).
#
#   DESARROLLO: no necesitas .env. docker-compose.yml ya trae valores locales.
#   PRODUCCIÓN: cp .env.example .env y completar TODO lo marcado (obligatorio).
#
# Nunca pegues secretos reales en este archivo ni los compartas por chat/correo.
# =============================================================================


# --- Dominios (PRODUCCIÓN, obligatorio) --------------------------------------
# Deben resolver por DNS (registro A) a la IP del servidor ANTES del primer
# `up`, o Let's Encrypt no podrá emitir los certificados.
DOMAIN_WEB=app.ambienta.cl
DOMAIN_API=api.ambienta.cl

# Correo al que Let's Encrypt avisa de certificados por expirar.
ACME_EMAIL=devops@ambienta.cl


# --- Tunel de Cloudflare (SOLO para el camino sin servidor propio) ----------
# Deja la Beta accesible en los dominios de arriba desde una maquina sin IP
# publica, sin abrir puertos en el router. Se usa asi:
#
#   docker compose -f docker-compose.prod.yml -f docker-compose.tunel.yml up -d
#
# El token lo da el panel de Cloudflare al crear el tunel (Zero Trust →
# Networks → Tunnels). **ES UN SECRETO:** quien lo tenga puede publicar su
# propio servicio en tu dominio. Va en `.env`, nunca aca.
#
# Requisito que no es obvio: el DNS del dominio tiene que estar **en
# Cloudflare**. Los registros del tunel apuntan a `<uuid>.cfargotunnel.com`, que
# solo resuelve ahi dentro. Ver docs/development/despliegue.md, 0.1.
TUNNEL_TOKEN=


# --- PostgreSQL (PRODUCCIÓN, obligatorio) ------------------------------------
# El dueno de la base. La API NO se conecta con el: ver APP_DB_PASSWORD.
POSTGRES_USER=ambienta
POSTGRES_DB=ambienta
# Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAR_password_generada_aleatoriamente

# Contrasena del rol `ambienta_app`, con el que SI se conecta la API.
#
# `db/07_rol_aplicacion.sql` lo crea con `ambienta_app_dev`, que esta escrita en
# un archivo versionado de un repositorio publico. En produccion
# `infra/postgres/init/99-password-del-rol-app.sh` la reemplaza por esta —y se
# niega a arrancar si es la de desarrollo—.
#
# Es el rol que NO puede saltarse RLS y al que aplica el
# `REVOKE UPDATE, DELETE ON audit_log`: esa es la razon de que la API no use el
# dueno de la base.
#
# Generar con: openssl rand -base64 32
APP_DB_PASSWORD=CAMBIAR_password_generada_aleatoriamente


# --- API URL para el frontend (PRODUCCIÓN, obligatorio) ---------------------
# Esta variable se incrusta en el bundle de Next.js durante el build.
# Cambiarla requiere reconstruir la imagen del frontend.
NEXT_PUBLIC_API_URL=https://api.ambienta.cl/api/v1


# --- Autenticación: Clerk (ADR-006) ------------------------------------------
# Clerk es el proveedor de identidad. La API NO emite tokens propios: valida
# los de Clerk contra su JWKS pública. Ver:
#   docs/arquitectura/adr/ADR-006-autenticacion-clerk.md
#   openspec/changes/integracion-clerk-auth/design.md
#
# Reemplaza a JWT_SECRET y a MICROSOFT_/GOOGLE_CLIENT_ID: la API ya no emite
# tokens propios ni recibe el callback de OAuth.
#
# DESARROLLO: déjalas vacías. Sin CLERK_JWKS_URL la API acepta el header
# X-Tenant-Id y el frontend muestra el DevRoleSwitcher. No necesitas cuenta
# de Clerk para levantar el proyecto.
#
# PRODUCCIÓN: son obligatorias. Con CLERK_JWKS_URL puesta, la API deja de
# aceptar X-Tenant-Id y exige un JWT firmado en todos los endpoints.

# --- Base de datos ---
# La API se conecta con `ambienta_app`: NO es superusuario y NO puede saltarse
# Row Level Security. Es lo que hace que el aislamiento entre empresas viva en
# la conexion y no en que alguien recuerde cambiar de rol en cada transaccion.
# En produccion hay que cambiar esta contrasena.
# **Con `docker-compose.prod.yml` estas dos no se usan: el compose las arma**
# desde POSTGRES_* y APP_DB_PASSWORD, para que no exista la posibilidad de que
# la URL diga una contrasena y el rol tenga otra. Sirven para correr la API
# fuera de compose (pruebas, un script, una consola).
DATABASE_URL=postgresql+psycopg://ambienta_app:CAMBIAR@postgres:5432/ambienta

# Dueno de la base, que SI salta RLS. Lo usan solo el webhook de Clerk —un
# `user.deleted` llega sin metadatos y hay que poder buscar en todas las
# empresas— y el health del esquema. Si se deja vacia, el webhook falla al
# escribir: degrada esa integracion, no el aislamiento.
DATABASE_ADMIN_URL=

# --- AI Service (overlay docker-compose.ai-prod.yml, opcional) --------------
# Estas URLs apuntan a la MISMA base `ambienta` del servicio postgres.
# No se crea otra base ni se exponen estos roles al host.
AI_DATABASE_URL_ADMIN=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/ambienta
AI_DB_CONSULTA_PASSWORD=CAMBIAR_clave_aleatoria
AI_DB_SINCRONIZADOR_PASSWORD=CAMBIAR_clave_aleatoria
AI_DATABASE_URL_CONSULTA=postgresql://ia_consulta:CAMBIAR_clave_aleatoria@postgres:5432/ambienta
AI_DATABASE_URL_SINCRONIZADOR=postgresql://ia_sincronizador:CAMBIAR_clave_aleatoria@postgres:5432/ambienta
AI_DIMENSION_EMBEDDINGS=1536
AI_PROVEEDOR_LLM=openai
AI_MODELO_LLM=gpt-4o-mini
AI_PROVEEDOR_EMBEDDINGS=openai
AI_MODELO_EMBEDDINGS=text-embedding-3-small
AI_UMBRAL_EVIDENCIA=0.40
AI_SERVICIO_TOKEN=
# JSON fuera del repo: [{"tenant_id":"...","token":"..."}, ...]
AI_TENANT_ACCOUNTS_FILE=./secrets/ai-tenant-accounts.json
AI_MONITOREO_TOKEN_PLATAFORMA=
AI_MONITOREO_INTERVALO_SEGUNDOS=86400
AI_INGESTA_INTERVALO_SEGUNDOS=1800

# --- Backend (apps/api) ---
# El interruptor: su presencia activa Clerk en toda la API.
#   dashboard.clerk.com → API Keys → "Show API URLs" → JWKS URL
CLERK_JWKS_URL=
# Emisor esperado (claim `iss`). Impide que un JWT de otra instancia de Clerk
# sirva contra esta API. Suele ser https://<tu-dominio>.clerk.accounts.dev
CLERK_ISSUER=
# Verificación de firma de los webhooks (protocolo svix).
#   dashboard.clerk.com → Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET=

# --- Token del Cliente Invitado (RF-01, RF-02, RF-07) -----------------------
# El invitado no es cuenta de Clerk, asi que su sesion la firma esta API con su
# propio secreto (HS256).
#
# **Sin esta variable el ingreso de invitados se niega con 503.** Es a
# proposito: un valor por defecto en el codigo seria un secreto publicado, y
# cualquiera que lea el repositorio podria firmarse una sesion de invitado de
# la empresa que quisiera.
#
# Generar uno propio por entorno:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_INVITADO_SECRETO=

# --- Frontend (apps/web) ---
# NEXT_PUBLIC_* se hornea en el bundle: cambiarlas exige rebuild, no basta
# reiniciar el contenedor.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Estas tres **no las lee nadie**: `AuthProvider.tsx` le pasa `signInUrl`,
# `signUpUrl` y `afterSignOutUrl` como props al `ClerkProvider`, que ganan por
# sobre la variable de entorno. Quedan porque son la convencion del SDK, pero
# cambiarlas aca no cambia nada — hay que editar el componente.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# Nombre del JWT Template que inyecta el claim `tenant_id`. El frontend pide
# el token POR NOMBRE: `getToken()` a secas devuelve el token de sesión
# estándar, que NO lleva claims personalizados, y la API lo rechaza con 401.
# Que el template se llame "default" no lo vuelve el predeterminado.
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=default

# El servicio `web` también necesita la clave secreta: `clerkMiddleware()`
# corre en el servidor de Next y falla con "Missing secretKey" sin ella. No es
# exclusiva del backend.
#
# **Y la necesita en tiempo de ejecución, no de build**: no es `NEXT_PUBLIC_*`,
# así que no se hornea en la imagen. El compose de producción se la pasa a los
# dos servicios, `api` y `web`. Durante meses se la pasó solo a `api` — y como
# el login es público, el primer deploy se habría visto perfecto hasta que
# alguien intentara entrar.
CLERK_SECRET_KEY=

# NOTA: el SSO con Microsoft y Google NO se configura acá. Se configura en el
# dashboard de Clerk (SSO Connections), y el callback de OAuth va a Clerk, no
# a nuestra API. Por eso ya no existen MICROSOFT_CLIENT_ID ni GOOGLE_CLIENT_ID.


# --- Correo transaccional — Resend (#122) ------------------------------------
# Proveedor oficial por decisión cerrada #18 del funcional v1.7, y así lo dice
# el esquema desde el principio: `notifications.provider_message_id` está
# comentada como "ID de Resend".
#
# Sin esto, los avisos de vencimiento por correo quedan **encolados sin gastar
# intentos** y las notificaciones in-app se entregan igual. No se escribe el
# correo a un log dándolo por entregado: en este dominio el peor resultado
# posible es que la empresa crea que le avisaron.
#
# RESEND_API_KEY — resend.com → API Keys. Con permiso de "Sending access"
#   basta. Se muestra una sola vez.
#   **ES UN SECRETO.** Va en `.env`, que está en `.gitignore`. Nunca acá.
#
# CORREO_REMITENTE — con el formato `Ambienta <avisos@tudominio.cl>`.
#   **El dominio tiene que estar verificado en Resend** (Domains → Add Domain,
#   y después los registros DNS que pide: SPF y DKIM). Sin verificar, Resend
#   responde 403 y el despacho se corta con un mensaje que lo dice.
#
#   Resend deja usar `onboarding@resend.dev` sin dominio propio, **pero solo
#   envía a la dirección con la que se registró la cuenta**. Sirve para
#   comprobar la instalación, no para avisarle a un cliente.
#
# CORREO_RESPONDER_A — adónde contesta quien responde el aviso. Vacío = al
#   remitente, que suele ser un buzón que nadie lee.
#
# Para comprobar que sirve, con un destino real:
#
#   docker compose exec api python -m app.tareas.comprobar_correo tu@correo.cl
#
RESEND_API_KEY=
CORREO_REMITENTE=
CORREO_RESPONDER_A=


# --- El AI Service (RF-59 a RF-63, OPCIONAL) --------------------------------
# La URL **interna** del servicio de IA. La API la usa como fachada: el
# navegador nunca habla con el AI Service, porque ese servicio consulta la base
# con el token de quien pregunta y un puerto abierto es una puerta que nadie
# vigila.
#
# **Vacía: sin ella `/support/chatbot/consulta` responde 503** diciendo que
# falta, y el resto del sistema funciona igual. No cae a `localhost:8100` a
# propósito: en producción eso es una conexión a nada que tarda en fallar, y
# "el chat no responde" no se parece a "falta una variable".
#
# El AI Service va en su propio overlay de compose, que es el que crea ese
# servicio:
#
#   docker compose -f docker-compose.yml -f docker-compose.ai-dev.yml up -d
#   AI_SERVICE_URL=http://ai-service:8100
#
# El nombre es el del servicio en la red del compose, no `localhost`.
AI_SERVICE_URL=


# --- Catálogo normativo BCN (OPCIONAL) --------------------------------------
# Dos fuentes, y solo una funciona hoy:
#
#   1. datos.bcn.cl/sparql — datos abiertos enlazados, SIN autenticación.
#      De aquí salen los metadatos, las relaciones entre normas y las
#      versiones. Es lo que usa la ingesta y no necesita ninguna clave.
#
#   2. La API de Ley Chile — entrega el texto de los artículos y SÍ exige
#      clave. Se solicita en bcn.cl/leychile/api y la BCN la habilita a mano:
#      recién activada empieza a responder. Sin ella la ingesta funciona
#      igual, solo que `legal_articles` queda vacía.
#
# NUNCA poner el valor acá: este archivo se versiona. Va en `.env`, que no.
BCN_API_KEY=

# Empresa del link publico del Cliente Invitado.
#
# El enlace real lleva `?empresa=<uuid>`; esta variable existe para que la demo
# funcione abriendo /acceso-invitado a secas. **Sin ninguna de las dos la
# pantalla se niega a generar credenciales**, en vez de elegir una empresa al
# azar y darle a la persona acceso a una que no es la suya.
NEXT_PUBLIC_EMPRESA_INVITADO=

# ─────────────────────────────────────────────────────────────────────────
# Almacenamiento de archivos — Backblaze B2 (ADR-005, RF-110)
# ─────────────────────────────────────────────────────────────────────────
#
# Se habla por la API compatible con S3, asi que estas mismas variables sirven
# para S3, R2 o cualquier otro proveedor S3-compatible: cambia el endpoint.
#
# **Sin estas variables la subida de archivos responde 503 con un mensaje
# claro, y el resto del sistema funciona igual.** No hay respaldo a disco
# local a proposito: guardar en el disco del servidor sin que nadie lo haya
# decidido produce archivos sin respaldo que se pierden en el primer
# redespliegue, y la empresa los cree guardados.
#
# ── Que poner en cada una ────────────────────────────────────────────────
#
# STORAGE_ENDPOINT — el que muestra la consola de B2 en la ficha del bucket,
#   **sin `https://`**. Ej: s3.us-east-005.backblazeb2.com
#
# STORAGE_REGION — la region va dentro del endpoint: de
#   `s3.us-east-005.backblazeb2.com` sale `us-east-005`. Se declara aparte
#   porque la firma v4 la necesita explicita.
#
# STORAGE_BUCKET — el **nombre** del bucket, no su ID. La consola muestra los
#   dos y son distintos: el ID es un hexadecimal, el nombre es el que elegiste.
#   La API de S3 usa el nombre.
#
# STORAGE_KEY_ID y STORAGE_KEY — se crean en B2 en "Application Keys" →
#   "Add a New Application Key". **La clave se muestra UNA sola vez**: si se
#   pierde, se borra y se crea otra.
#
#   Al crearla:
#     - "Allow access to Bucket(s)": elegir **solo este bucket**, no "All".
#       Una llave que ve todos los buckets convierte cualquier filtracion en
#       una filtracion de todo.
#     - "Type of Access": **Read and Write**.
#     - "File name prefix": dejarlo vacio. Las rutas ya llevan el `tenant_id`
#       adelante (`tenants/<uuid>/documents/...`), asi que si algun dia hace
#       falta una llave acotada a una empresa, se crea con ese prefijo.
#
# STORAGE_KEY ES UN SECRETO. Va en `.env`, que esta en `.gitignore`.
# **Nunca en este archivo, que si se versiona.**

STORAGE_ENDPOINT=
STORAGE_REGION=us-east-005
STORAGE_BUCKET=
STORAGE_KEY_ID=
STORAGE_KEY=
