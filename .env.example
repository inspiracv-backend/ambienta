# =============================================================================
# Plantilla de variables de entorno de Ambienta
# =============================================================================
#
# Este archivo se versiona; el .env real NO (está en .gitignore).
#
#   DESARROLLO: no necesitas .env. docker-compose.yml ya trae valores locales.
#   PRODUCCIÓN: cp .env.example .env y completar TODO lo marcado (obligatorio).
#
# Nunca pegues secretos reales en este archivo ni los compartas por chat/correo.
# =============================================================================


# --- Dominios (PRODUCCIÓN, obligatorio) --------------------------------------
# Deben resolver por DNS (registro A) a la IP del servidor ANTES del primer
# `up`, o Let's Encrypt no podrá emitir los certificados.
DOMAIN_WEB=app.ambienta.cl
DOMAIN_API=api.ambienta.cl

# Correo al que Let's Encrypt avisa de certificados por expirar.
ACME_EMAIL=devops@ambienta.cl


# --- PostgreSQL (PRODUCCIÓN, obligatorio) ------------------------------------
POSTGRES_USER=ambienta
POSTGRES_DB=ambienta
# Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAR_password_generada_aleatoriamente


# --- Autenticación (obligatorio) ---------------------------------------------
# Mínimo 32 caracteres — la API no arranca si es más corto.
# Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_secreto_de_al_menos_32_caracteres_aqui


# --- API URL para el frontend (PRODUCCIÓN, obligatorio) ---------------------
# Esta variable se incrusta en el bundle de Next.js durante el build.
# Cambiarla requiere reconstruir la imagen del frontend.
NEXT_PUBLIC_API_URL=https://api.ambienta.cl/api/v1


# --- OAuth / SSO (OPCIONAL por ahora) ----------------------------------------
# Mientras estén vacías, el login social queda deshabilitado: los endpoints
# /auth/{proveedor}/callback responden 501 y la API loguea una advertencia en
# cada arranque. Ver openspec/changes/sistema-actores-roles-rbac/design.md.
#
# Microsoft Entra ID (proveedor prioritario según el Análisis Funcional v1.7):
#   portal.azure.com → Entra ID → App registrations → New registration
#   Redirect URI: https://<DOMAIN_API>/api/v1/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Google Cloud → APIs & Services → Credentials → OAuth client ID
#   Redirect URI: https://<DOMAIN_API>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- Correo transaccional (OPCIONAL hasta implementar notificaciones) --------
# Resend es el proveedor oficial (decisión cerrada #18 del funcional v1.7).
# resend.com → API Keys
RESEND_API_KEY=
