# Copiar a .env. Ningún valor real va al repositorio.

# Backend de Ambienta
BACKEND_URL=http://api:8000/api/v1

# Identidad. Sin CLERK_JWKS_URL el servicio corre en modo desarrollo (X-Tenant-Id, nada se guarda).
CLERK_JWKS_URL=
CLERK_ISSUER=

# Base de conocimiento: un rol por uso (SPEC-03)
DATABASE_URL_CONSULTA=postgresql://ia_consulta:<clave>@ia-db:5432/ambienta_ia
DATABASE_URL_SINCRONIZADOR=postgresql://ia_sincronizador:<clave>@ia-db:5432/ambienta_ia
# Solo para migrar
DATABASE_URL_ADMIN=postgresql://postgres:<clave>@ia-db:5432/ambienta_ia
CLAVE_IA_CONSULTA=
CLAVE_IA_SINCRONIZADOR=

# Cuenta servicio_lectura del backend, solo para sincronizar el catálogo
SERVICIO_TOKEN=
# ...o, contra un backend en modo desarrollo:
SERVICIO_TENANT_ID=

# Proveedores (decisiones A y B del plan). "falso" y "local" son para demo y pruebas.
PROVEEDOR_LLM=openai
MODELO_LLM=gpt-4o-mini
PROVEEDOR_EMBEDDINGS=openai
MODELO_EMBEDDINGS=text-embedding-3-small
DIMENSION_EMBEDDINGS=1536
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Calibrados con la evaluación (SPEC-08)
UMBRAL_EVIDENCIA=0.40
K_RECUPERACION=5
MAX_HERRAMIENTAS=6
MAX_REVISIONES=2
MAX_TOKENS_CONSULTA=20000
TURNOS_DE_CONTEXTO=10
REVISOR_CON_MODELO=true
REORDENAR_CON_MODELO=true
